{
  "name": "ai-review-platform",
  "version": "0.3.2",
  "private": true,
  "description": "Modular, plugin-based, event-driven, provider-agnostic Multi-Agent AI Code Review Platform.",
  "type": "module",
  "main": "main.cjs",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "build": "turbo run build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:express --external:fsevents --sourcemap --outfile=dist/server.cjs",
    "test": "turbo run test",
    "lint": "turbo run typecheck",
    "repo:sync": "tsx scripts/repo-sync.ts",
    "eval": "turbo run test --filter=@ai-review/eval",
    "reset-password": "tsx scripts/reset-password.ts",
    "e2e": "node scripts/e2e.mjs",
    "eval:mock": "tsx packages/eval/src/cli.ts",
    "eval:rules": "tsx packages/eval/src/rules-cli.ts",
    "eval:live": "tsx packages/eval/src/live-cli.ts",
    "start": "node dist/server.cjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "desktop": "concurrently \"npm run start -- --port 4000\" \"wait-on http://localhost:4000 && electron .\"",
    "build:desktop": "npm run build && electron-builder",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-review/agent-runtime": "*",
    "@ai-review/config": "*",
    "@ai-review/context-engine": "*",
    "@ai-review/git": "*",
    "@ai-review/memory": "*",
    "@ai-review/orchestrator": "*",
    "@ai-review/project-index": "*",
    "@ai-review/shared": "*",
    "@ai-review/workflow-engine": "*",
    "electron-updater": "^6.8.11",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "lucide-react": "^1.31.0",
    "turbo": "^2.11.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^8.3.7",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.aireview.app",
    "productName": "AI Code Reviewer",
    "artifactName": "AI-Code-Reviewer-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "whossein",
      "repo": "ai-platform-review"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/web/dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  }
}

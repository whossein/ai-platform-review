{
  "name": "@ai-review/git",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-agnostic git integration. First implementation: GitLab (self-hosted) via REST — read MR/diff/discussions, create/reply/resolve discussions, approve, pipeline status.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-review/core": "*",
    "@ai-review/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  }
}
